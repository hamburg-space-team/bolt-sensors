{
    "name": "bolt-sensors",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": ["--add-host=bolt-station.local:134.28.54.90"],

    "privileged": true,
    "mounts": [
        // "source=/dev/bus/usb,target=/dev/bus/usb,type=bind"
        "source=bolt-sensors-cmsis-packs,target=/opt/cmsis-packs,type=volume"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "marus25.cortex-debug",
                "llvm-vs-code-extensions.vscode-clangd",
                "Arm.cmsis-csolution",
                "usernamehw.errorlens",
                "PKief.material-icon-theme",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "xaver.clang-format",
                "dbaeumer.vscode-eslint",
                "mcu-debug.memory-view",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "DavidAnson.vscode-markdownlint",
                "ms-vscode.vscode-serial-monitor",
                "bradlc.vscode-tailwindcss",
                "Arm.vscode-cmsis-debugger",
                "Arm.keil-studio-pack",
                "rust-lang.rust-analyzer"
            ],
            "settings": {
                "clangd.arguments": [
                    "--compile-commands-dir=${workspaceFolder}/examples/tmp"
                ],
                "git.alwaysSignOff": true
            }
        }
    },

    "remoteUser": "vscode"
}
